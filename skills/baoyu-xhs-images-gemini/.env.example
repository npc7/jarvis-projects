# Google Gemini API Configuration
# Copy this file to .env and add your API key

GEMINI_API_KEY=your_gemini_api_key_here

# Optional: You can also set the API key as an environment variable
# export GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Model preferences (default is gemini-3-pro-image-preview with fallback)
# PRIMARY_MODEL=gemini-3-pro-image-preview
# FALLBACK_MODEL=gemini-2.5-flash-image

# Optional: Timeout settings (in seconds)
# GENERATION_TIMEOUT=120
# RETRY_DELAY=5